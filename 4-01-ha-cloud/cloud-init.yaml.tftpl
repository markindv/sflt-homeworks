#cloud-config
datasource:
  Ec2:
    strict_id: false
ssh_pwauth: false
users:
  - name: netology
    groups: sudo
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    ssh_authorized_keys:
      - ${ssh_public_key}
package_update: true
packages:
  - nginx
runcmd:
  - [systemctl, enable, --now, nginx]

